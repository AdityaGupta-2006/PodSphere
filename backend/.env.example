# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/podsphere"

# Secret key used to sign and verify JWTs. Use a long, random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_replace_in_production"

# ─── Optional (defaults shown) ────────────────────────────────────────────────

# Server port. Note: on macOS, port 5000 may conflict with AirPlay Receiver.
# Use 5001 if you encounter EADDRINUSE errors.
PORT=5000

# Node environment. Use "production" in deployed environments.
NODE_ENV=development

# JWT expiry duration (uses ms/zeit format or seconds).
JWT_EXPIRES_IN=7d

# Allowed CORS origin for the frontend dev server.
CORS_ORIGIN=http://localhost:5173

# bcrypt salt rounds. Higher = more secure but slower. 10 is a safe default.
BCRYPT_ROUNDS=10

# Rate limiter window in milliseconds (default: 15 minutes = 900000 ms).
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP per window for general API routes.
RATE_LIMIT_MAX=100
