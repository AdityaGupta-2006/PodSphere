// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String
  role         Role

  studios  Studio[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Studio {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @db.Uuid
  name        String
  description String?
  city        String
  address     String
  hourlyRate  Decimal  @db.Decimal(10, 2)
  gear        String[] @default([])

  provider User      @relation(fields: [providerId], references: [id])
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  creatorId   String        @db.Uuid
  studioId    String        @db.Uuid
  startTime   DateTime
  endTime     DateTime
  totalAmount Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(CONFIRMED)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([studioId])
  @@index([studioId, startTime, endTime])
}

enum Role {
  USER
  PROVIDER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}
